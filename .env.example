# Copy to .env and fill in. Never commit .env (it is git-ignored).

APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=text                 # text | json
TIMEZONE=Asia/Kolkata

# --- AI engine ---------------------------------------------------------------------------
AI_MODEL_PATH=models/yolo11n.pt # downloaded automatically; yolo11s.pt = more accurate, slower
AI_DEVICE=auto                  # auto | cpu | cuda:0
AI_CONFIDENCE_THRESHOLD=0.4
AI_IOU_THRESHOLD=0.5
AI_IMAGE_SIZE=640

# --- SMS alerts --------------------------------------------------------------------------
# console = print SMS in the terminal (no account needed). Real: twilio | msg91 | aws_sns
SMS_PROVIDER=console
SMS_RECIPIENTS=+91XXXXXXXXXX    # comma-separated; 10-digit numbers get SMS_DEFAULT_COUNTRY_CODE
SMS_DEFAULT_COUNTRY_CODE=91
SMS_MAX_PER_HOUR=10             # per recipient, protects against alert storms

# Twilio (https://console.twilio.com)
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM_NUMBER=                # your Twilio number (+1...) or Messaging Service SID (MG...)

# MSG91 (DLT template; variables: severity, camera, location, event, time)
SMS_API_KEY=
SMS_TEMPLATE_ID=

# AWS SNS (pip install boto3; credentials via AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY)
AWS_REGION=ap-south-1
SMS_SENDER_ID=
SMS_DLT_ENTITY_ID=
SMS_DLT_TEMPLATE_ID=
